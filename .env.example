# ─── Site ────────────────────────────────────────────────────────────────────
# Your production URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Found in: Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price ID for your subscription product
# Found in: Stripe dashboard → Product catalog → [your product] → Pricing
STRIPE_PRICE_ID=

# Webhook signing secret — generated when you add a webhook endpoint in Stripe
# Endpoint: https://your-app.vercel.app/api/webhooks/stripe
# Event to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
